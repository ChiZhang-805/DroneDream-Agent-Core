{
  "$defs": {
    "Px4CoordinateContract": {
      "additionalProperties": false,
      "properties": {
        "collision_center_offset_model_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Collision Center Offset Model M",
          "type": "array"
        },
        "executor_x": {
          "const": "PX4 local north physically mapped to qualified-map ENU north",
          "default": "PX4 local north physically mapped to qualified-map ENU north",
          "title": "Executor X",
          "type": "string"
        },
        "executor_y": {
          "const": "PX4 local east physically mapped to qualified-map ENU east",
          "default": "PX4 local east physically mapped to qualified-map ENU east",
          "title": "Executor Y",
          "type": "string"
        },
        "executor_z": {
          "const": "PX4 local up",
          "default": "PX4 local up",
          "title": "Executor Z",
          "type": "string"
        },
        "model_root_world_enu_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Model Root World Enu M",
          "type": "array"
        },
        "source": {
          "const": "Gazebo ENU vehicle-collision-envelope center",
          "default": "Gazebo ENU vehicle-collision-envelope center",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "model_root_world_enu_m",
        "collision_center_offset_model_m"
      ],
      "title": "Px4CoordinateContract",
      "type": "object"
    },
    "Px4TrackPoint": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "launch",
            "transit",
            "stairs",
            "pickup",
            "return",
            "land"
          ],
          "title": "Phase",
          "type": "string"
        },
        "speed_limit_mps": {
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Speed Limit Mps",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "phase",
        "speed_limit_mps"
      ],
      "title": "Px4TrackPoint",
      "type": "object"
    },
    "WorldTrackPoint": {
      "additionalProperties": false,
      "properties": {
        "east_m": {
          "title": "East M",
          "type": "number"
        },
        "north_m": {
          "title": "North M",
          "type": "number"
        },
        "up_m": {
          "title": "Up M",
          "type": "number"
        }
      },
      "required": [
        "east_m",
        "north_m",
        "up_m"
      ],
      "title": "WorldTrackPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coordinate_contract": {
      "$ref": "#/$defs/Px4CoordinateContract"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/Px4TrackPoint"
      },
      "maxItems": 10000,
      "minItems": 2,
      "title": "Points",
      "type": "array"
    },
    "schema_version": {
      "const": "dronedream.px4-track.v2",
      "default": "dronedream.px4-track.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_world_points": {
      "items": {
        "$ref": "#/$defs/WorldTrackPoint"
      },
      "maxItems": 10000,
      "minItems": 2,
      "title": "Source World Points",
      "type": "array"
    },
    "stop_at_waypoints": {
      "default": true,
      "title": "Stop At Waypoints",
      "type": "boolean"
    },
    "track_type": {
      "const": "custom",
      "default": "custom",
      "title": "Track Type",
      "type": "string"
    },
    "waypoint_hold_seconds": {
      "maximum": 30.0,
      "minimum": 0.0,
      "title": "Waypoint Hold Seconds",
      "type": "number"
    },
    "waypoint_position_tolerance_m": {
      "default": 0.2,
      "exclusiveMinimum": 0.0,
      "maximum": 2.0,
      "title": "Waypoint Position Tolerance M",
      "type": "number"
    },
    "waypoint_settle_timeout_seconds": {
      "default": 12.0,
      "exclusiveMinimum": 0.0,
      "maximum": 120.0,
      "title": "Waypoint Settle Timeout Seconds",
      "type": "number"
    },
    "waypoint_speed_tolerance_mps": {
      "default": 0.15,
      "exclusiveMinimum": 0.0,
      "maximum": 2.0,
      "title": "Waypoint Speed Tolerance Mps",
      "type": "number"
    },
    "waypoint_stable_window_seconds": {
      "default": 0.5,
      "exclusiveMinimum": 0.0,
      "maximum": 10.0,
      "title": "Waypoint Stable Window Seconds",
      "type": "number"
    }
  },
  "required": [
    "coordinate_contract",
    "points",
    "source_world_points",
    "waypoint_hold_seconds"
  ],
  "title": "Px4Track",
  "type": "object"
}
