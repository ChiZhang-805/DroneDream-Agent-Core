{
  "$defs": {
    "GraphRoute": {
      "additionalProperties": false,
      "properties": {
        "all_edges_flight_verified": {
          "title": "All Edges Flight Verified",
          "type": "boolean"
        },
        "edge_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Edge Ids",
          "type": "array"
        },
        "goal_node": {
          "title": "Goal Node",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Node Ids",
          "type": "array"
        },
        "positions_m": {
          "items": {
            "$ref": "#/$defs/Vector3"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Positions M",
          "type": "array"
        },
        "route_length_m": {
          "minimum": 0.0,
          "title": "Route Length M",
          "type": "number"
        },
        "schema_version": {
          "const": "dronedream.graph-route.v1",
          "default": "dronedream.graph-route.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_node": {
          "title": "Start Node",
          "type": "string"
        }
      },
      "required": [
        "start_node",
        "goal_node",
        "node_ids",
        "edge_ids",
        "positions_m",
        "route_length_m",
        "all_edges_flight_verified"
      ],
      "title": "GraphRoute",
      "type": "object"
    },
    "PluginHookReceipt": {
      "additionalProperties": false,
      "description": "Hash-bound evidence for a non-tool Harness extension invocation.",
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hook": {
          "pattern": "^[a-z][a-z0-9._-]{1,95}$",
          "title": "Hook",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "invocation_id": {
          "pattern": "^hook-[0-9a-f]{24}$",
          "title": "Invocation Id",
          "type": "string"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Issue Codes",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "accepted",
            "skipped",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_package_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plugin Package Sha256",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.plugin-hook-receipt.v1",
          "default": "dronedream.plugin-hook-receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "invocation_id",
        "plugin_id",
        "plugin_version",
        "plugin_package_sha256",
        "capability_id",
        "slot_id",
        "hook",
        "outcome",
        "input_sha256",
        "output_sha256",
        "created_at"
      ],
      "title": "PluginHookReceipt",
      "type": "object"
    },
    "Px4CoordinateContract": {
      "additionalProperties": false,
      "properties": {
        "collision_center_offset_model_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Collision Center Offset Model M",
          "type": "array"
        },
        "executor_x": {
          "const": "PX4 local north physically mapped to qualified-map ENU north",
          "default": "PX4 local north physically mapped to qualified-map ENU north",
          "title": "Executor X",
          "type": "string"
        },
        "executor_y": {
          "const": "PX4 local east physically mapped to qualified-map ENU east",
          "default": "PX4 local east physically mapped to qualified-map ENU east",
          "title": "Executor Y",
          "type": "string"
        },
        "executor_z": {
          "const": "PX4 local up",
          "default": "PX4 local up",
          "title": "Executor Z",
          "type": "string"
        },
        "model_root_world_enu_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Model Root World Enu M",
          "type": "array"
        },
        "source": {
          "const": "Gazebo ENU vehicle-collision-envelope center",
          "default": "Gazebo ENU vehicle-collision-envelope center",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "model_root_world_enu_m",
        "collision_center_offset_model_m"
      ],
      "title": "Px4CoordinateContract",
      "type": "object"
    },
    "Px4Track": {
      "additionalProperties": false,
      "properties": {
        "coordinate_contract": {
          "$ref": "#/$defs/Px4CoordinateContract"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Px4TrackPoint"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "schema_version": {
          "const": "dronedream.px4-track.v2",
          "default": "dronedream.px4-track.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "source_world_points": {
          "items": {
            "$ref": "#/$defs/WorldTrackPoint"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Source World Points",
          "type": "array"
        },
        "stop_at_waypoints": {
          "default": true,
          "title": "Stop At Waypoints",
          "type": "boolean"
        },
        "track_type": {
          "const": "custom",
          "default": "custom",
          "title": "Track Type",
          "type": "string"
        },
        "waypoint_hold_seconds": {
          "maximum": 30.0,
          "minimum": 0.0,
          "title": "Waypoint Hold Seconds",
          "type": "number"
        },
        "waypoint_position_tolerance_m": {
          "default": 0.2,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Waypoint Position Tolerance M",
          "type": "number"
        },
        "waypoint_settle_timeout_seconds": {
          "default": 12.0,
          "exclusiveMinimum": 0.0,
          "maximum": 120.0,
          "title": "Waypoint Settle Timeout Seconds",
          "type": "number"
        },
        "waypoint_speed_tolerance_mps": {
          "default": 0.15,
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "title": "Waypoint Speed Tolerance Mps",
          "type": "number"
        },
        "waypoint_stable_window_seconds": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 10.0,
          "title": "Waypoint Stable Window Seconds",
          "type": "number"
        }
      },
      "required": [
        "coordinate_contract",
        "points",
        "source_world_points",
        "waypoint_hold_seconds"
      ],
      "title": "Px4Track",
      "type": "object"
    },
    "Px4TrackPoint": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "launch",
            "transit",
            "stairs",
            "pickup",
            "return",
            "land"
          ],
          "title": "Phase",
          "type": "string"
        },
        "speed_limit_mps": {
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Speed Limit Mps",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "phase",
        "speed_limit_mps"
      ],
      "title": "Px4TrackPoint",
      "type": "object"
    },
    "RouteClearanceReport": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "collision_count": {
          "minimum": 0,
          "title": "Collision Count",
          "type": "integer"
        },
        "collisions": {
          "items": {
            "$ref": "#/$defs/RouteCollision"
          },
          "maxItems": 100,
          "title": "Collisions",
          "type": "array"
        },
        "minimum_clearance_m": {
          "title": "Minimum Clearance M",
          "type": "number"
        },
        "minimum_clearance_point": {
          "$ref": "#/$defs/Vector3"
        },
        "minimum_clearance_primitive": {
          "title": "Minimum Clearance Primitive",
          "type": "string"
        },
        "primitive_count": {
          "minimum": 1,
          "title": "Primitive Count",
          "type": "integer"
        },
        "route_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Sha256",
          "type": "string"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_interval_m": {
          "exclusiveMinimum": 0.0,
          "title": "Sample Interval M",
          "type": "number"
        },
        "schema_version": {
          "const": "dronedream.route-clearance.v1",
          "default": "dronedream.route-clearance.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_minimum_clearances_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 9999,
          "title": "Segment Minimum Clearances M",
          "type": "array"
        },
        "semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Sha256",
          "type": "string"
        }
      },
      "required": [
        "accepted",
        "route_sha256",
        "semantic_sha256",
        "sample_interval_m",
        "sample_count",
        "primitive_count",
        "collision_count",
        "minimum_clearance_m",
        "minimum_clearance_point",
        "minimum_clearance_primitive"
      ],
      "title": "RouteClearanceReport",
      "type": "object"
    },
    "RouteCollision": {
      "additionalProperties": false,
      "properties": {
        "clearance_m": {
          "title": "Clearance M",
          "type": "number"
        },
        "position_m": {
          "$ref": "#/$defs/Vector3"
        },
        "primitive_name": {
          "title": "Primitive Name",
          "type": "string"
        },
        "sample_index": {
          "minimum": 0,
          "title": "Sample Index",
          "type": "integer"
        }
      },
      "required": [
        "sample_index",
        "position_m",
        "primitive_name",
        "clearance_m"
      ],
      "title": "RouteCollision",
      "type": "object"
    },
    "RuntimeActionExecutionContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Adapter Catalog Sha256",
          "type": "string"
        },
        "contract_id": {
          "title": "Contract Id",
          "type": "string"
        },
        "domain_action_catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Domain Action Catalog Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.runtime-action-execution.v1",
          "default": "dronedream.runtime-action-execution.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/RuntimeActionExecutionStep"
          },
          "maxItems": 128,
          "title": "Steps",
          "type": "array"
        },
        "task_graph_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Graph Sha256",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "task_graph_sha256",
        "domain_action_catalog_sha256",
        "adapter_catalog_sha256"
      ],
      "title": "RuntimeActionExecutionContract",
      "type": "object"
    },
    "RuntimeActionExecutionStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 120,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Action",
          "type": "string"
        },
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "authority": {
          "enum": [
            "simulate",
            "control",
            "actuate"
          ],
          "title": "Authority",
          "type": "string"
        },
        "checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^checkpoint-[0-9]{3,6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Depends On",
          "type": "array"
        },
        "driver": {
          "enum": [
            "mavsdk-camera",
            "gazebo-payload",
            "payload-transition",
            "ros2-service"
          ],
          "title": "Driver",
          "type": "string"
        },
        "fallback": {
          "enum": [
            "continue",
            "hold",
            "return",
            "land",
            "abort"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "max_attempts": {
          "maximum": 9,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "required_success_evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Required Success Evidence",
          "type": "array"
        },
        "runtime_executor": {
          "title": "Runtime Executor",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.runtime-action-step.v1",
          "default": "dronedream.runtime-action-step.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "step_id": {
          "pattern": "^action-[0-9]{3,6}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_node": {
          "title": "Target Node",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 300.0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "trigger": {
          "enum": [
            "post-takeoff",
            "post-replan",
            "checkpoint"
          ],
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "task_id",
        "action",
        "target_node",
        "trigger",
        "runtime_executor",
        "adapter_id",
        "driver",
        "required_success_evidence",
        "max_attempts",
        "fallback",
        "timeout_seconds",
        "authority"
      ],
      "title": "RuntimeActionExecutionStep",
      "type": "object"
    },
    "RuntimeCheckpoint": {
      "additionalProperties": false,
