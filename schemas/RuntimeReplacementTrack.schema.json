          "items": {
            "$ref": "#/$defs/RuntimeCheckpoint"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Checkpoints",
          "type": "array"
        },
        "contract_id": {
          "title": "Contract Id",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.runtime-checkpoints.v1",
