        "segment_id": {
          "pattern": "^segment-[0-9]{3,6}$",
          "title": "Segment Id",
          "type": "string"
        },
        "target_node": {
          "title": "Target Node",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "track_point_index": {
          "minimum": 1,
