  "additionalProperties": false,
  "description": "A code-validated track that may supersede the active track during stable hold.",
  "properties": {
    "amendment_action": {
      "default": "replan",
      "enum": [
        "replan",
        "redirect",
        "set_speed",
        "return_home",
        "set_return_point",
        "set_coverage",
        "follow_target"
      ],
      "title": "Amendment Action",
      "type": "string"
    },
    "amendment_parameters": {
      "additionalProperties": true,
      "title": "Amendment Parameters",
      "type": "object"
    },
