          "title": "Plugin Id"
        },
        "plugin_package_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin Package Sha256"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "outcome",
        "input_sha256",
        "output_sha256"
      ],
      "title": "RuntimeToolReceipt",
      "type": "object"
    },
    "TaskGraph": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/TaskNode"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "revision": {
