{
  "additionalProperties": false,
  "description": "Persisted import state; transitions validate a new revision without mutating this one.",
  "properties": {
    "asset_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "asset_kind": {
      "anyOf": [
        {
          "enum": [
            "map",
            "world",
            "vehicle"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Kind"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detected_source_format": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detected Source Format"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Issue Codes",
      "type": "array"
    },
    "job_id": {
      "pattern": "^asset-job-[0-9a-f]{24}$",
      "title": "Job Id",
      "type": "string"
    },
    "normalized_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Content Sha256"
    },
    "owner_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "package_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Sha256"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "qualified_content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualified Content Sha256"
    },
    "required_inputs": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "title": "Required Inputs",
      "type": "array"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "dronedream.asset-import-job.v1",
      "default": "dronedream.asset-import-job.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_adapter_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Adapter Id"
    },
    "source_format": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Source Format",
      "type": "string"
    },
    "source_name": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    },
    "state": {
      "default": "created",
      "enum": [
        "created",
        "quarantining",
        "parsing",
        "needs_input",
        "normalizing",
        "building",
        "validating",
        "qualified",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "owner_id",
    "source_name",
    "source_format",
    "progress_percent",
    "revision",
    "created_at",
    "updated_at"
  ],
  "title": "AssetImportJob",
  "type": "object"
}
