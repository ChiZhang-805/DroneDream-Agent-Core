{
  "$defs": {
    "AssetQualificationInputs": {
      "additionalProperties": false,
      "properties": {
        "controller_params": {
          "title": "Controller Params",
          "type": "string"
        },
        "graph": {
          "title": "Graph",
          "type": "string"
        },
        "map_asset_id": {
          "title": "Map Asset Id",
          "type": "string"
        },
        "map_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Map Content Sha256",
          "type": "string"
        },
        "px4_sitl_model": {
          "title": "Px4 Sitl Model",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.asset-qualification-inputs.v1",
          "default": "dronedream.asset-qualification-inputs.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic": {
          "title": "Semantic",
          "type": "string"
        },
        "vehicle_asset_id": {
          "title": "Vehicle Asset Id",
          "type": "string"
        },
        "vehicle_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vehicle Content Sha256",
          "type": "string"
        },
        "vehicle_metadata": {
          "title": "Vehicle Metadata",
          "type": "string"
        },
        "vehicle_name": {
          "title": "Vehicle Name",
          "type": "string"
        },
        "vehicle_sdf": {
          "title": "Vehicle Sdf",
          "type": "string"
        },
        "world_name": {
          "title": "World Name",
          "type": "string"
        },
        "world_sdf": {
          "title": "World Sdf",
          "type": "string"
        }
      },
      "required": [
        "map_asset_id",
        "map_content_sha256",
        "vehicle_asset_id",
        "vehicle_content_sha256",
        "world_sdf",
        "semantic",
        "graph",
        "vehicle_sdf",
        "vehicle_metadata",
        "controller_params",
        "world_name",
        "vehicle_name",
        "px4_sitl_model"
      ],
      "title": "AssetQualificationInputs",
      "type": "object"
    },
    "GraphRoute": {
      "additionalProperties": false,
      "properties": {
        "all_edges_flight_verified": {
          "title": "All Edges Flight Verified",
          "type": "boolean"
        },
        "edge_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Edge Ids",
          "type": "array"
        },
        "goal_node": {
          "title": "Goal Node",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Node Ids",
          "type": "array"
        },
        "positions_m": {
          "items": {
            "$ref": "#/$defs/Vector3"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Positions M",
          "type": "array"
        },
        "route_length_m": {
          "minimum": 0.0,
          "title": "Route Length M",
          "type": "number"
        },
        "schema_version": {
          "const": "dronedream.graph-route.v1",
          "default": "dronedream.graph-route.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_node": {
          "title": "Start Node",
          "type": "string"
        }
      },
      "required": [
        "start_node",
        "goal_node",
        "node_ids",
        "edge_ids",
        "positions_m",
        "route_length_m",
        "all_edges_flight_verified"
      ],
      "title": "GraphRoute",
      "type": "object"
    },
    "Vector3": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clearance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Clearance Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/AssetQualificationInputs"
    },
    "qualification_id": {
      "pattern": "^asset-qualification-[0-9a-f]{24}$",
      "title": "Qualification Id",
      "type": "string"
    },
    "required_runtime_gates": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Required Runtime Gates",
      "type": "array"
    },
    "route": {
      "$ref": "#/$defs/GraphRoute"
    },
    "route_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Route Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.asset-pair-qualification-plan.v1",
      "default": "dronedream.asset-pair-qualification-plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "track_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Track Sha256",
      "type": "string"
    }
  },
  "required": [
    "qualification_id",
    "created_at",
    "inputs",
    "route",
    "route_sha256",
    "clearance_sha256",
    "track_sha256",
    "required_runtime_gates"
  ],
  "title": "AssetPairQualificationPlan",
  "type": "object"
}
