{
  "$defs": {
    "LocalPolicyTrainingMetrics": {
      "additionalProperties": false,
      "properties": {
        "action_accuracy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Action Accuracy",
          "type": "number"
        },
        "authorized_motion_recall": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Authorized Motion Recall",
          "type": "number"
        },
        "candidate_sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Candidate Sample Count",
          "type": "integer"
        },
        "candidate_selection_accuracy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Candidate Selection Accuracy",
          "type": "number"
        },
        "mean_cross_entropy": {
          "minimum": 0.0,
          "title": "Mean Cross Entropy",
          "type": "number"
        },
        "motion_authorization_accuracy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Motion Authorization Accuracy",
          "type": "number"
        },
        "motion_sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Motion Sample Count",
          "type": "integer"
        },
        "non_motion_recall": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Non Motion Recall",
          "type": "number"
        },
        "non_motion_sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Non Motion Sample Count",
          "type": "integer"
        },
        "pilot_axis_evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/PilotAxisEvidence"
          },
          "maxProperties": 4,
          "title": "Pilot Axis Evidence",
          "type": "object"
        },
        "pilot_control_mean_absolute_error": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pilot Control Mean Absolute Error"
        },
        "risk_hold_recall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Hold Recall",
          "type": "number"
        },
        "risk_mean_absolute_error": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Mean Absolute Error",
          "type": "number"
        },
        "risky_sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Risky Sample Count",
          "type": "integer"
        },
        "safe_motion_recall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Safe Motion Recall",
          "type": "number"
        },
        "safe_sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Safe Sample Count",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "sample_count",
        "action_accuracy",
        "motion_authorization_accuracy",
        "candidate_selection_accuracy",
        "risk_hold_recall",
        "safe_motion_recall",
        "risk_mean_absolute_error",
        "mean_cross_entropy"
      ],
      "title": "LocalPolicyTrainingMetrics",
      "type": "object"
    },
    "PilotAxisEvidence": {
      "additionalProperties": false,
      "properties": {
        "active_mean_absolute_error": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Mean Absolute Error"
        },
        "maximum_absolute_error": {
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Maximum Absolute Error",
          "type": "number"
        },
        "mean_absolute_error": {
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Mean Absolute Error",
          "type": "number"
        },
        "negative_sample_count": {
          "minimum": 0,
          "title": "Negative Sample Count",
          "type": "integer"
        },
        "neutral_sample_count": {
          "minimum": 0,
          "title": "Neutral Sample Count",
          "type": "integer"
        },
        "positive_sample_count": {
          "minimum": 0,
          "title": "Positive Sample Count",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        }
      },
      "required": [
        "sample_count",
        "positive_sample_count",
        "negative_sample_count",
        "neutral_sample_count",
        "mean_absolute_error",
        "maximum_absolute_error"
      ],
      "title": "PilotAxisEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Independent simulation evidence required before a policy can be selected.",
  "properties": {
    "collision_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Collision Count",
      "type": "integer"
    },
    "control_feature_contract_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Feature Contract Sha256"
    },
    "deterministic_safety_intervention_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Deterministic Safety Intervention Count",
      "type": "integer"
    },
    "evaluation_suite_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluation Suite Sha256",
      "type": "string"
    },
    "expert_expected_invocation_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "perception-encoder",
          "local-navigation-policy",
          "precision-maneuver-policy",
          "recovery-policy",
          "risk-critic",
          "perception-health-critic",
          "settle-stability-critic",
          "payload-dynamics-adapter",
          "state-anomaly-detector",
          "cross-modal-consistency-critic"
        ]
      },
      "title": "Expert Expected Invocation Counts",
      "type": "object"
    },
    "expert_observed_invocation_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "perception-encoder",
          "local-navigation-policy",
          "precision-maneuver-policy",
          "recovery-policy",
          "risk-critic",
          "perception-health-critic",
          "settle-stability-critic",
          "payload-dynamics-adapter",
          "state-anomaly-detector",
          "cross-modal-consistency-critic"
        ]
      },
      "title": "Expert Observed Invocation Counts",
      "type": "object"
    },
    "issue_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Issue Codes",
      "type": "array"
    },
    "local_policy_call_count": {
      "anyOf": [
        {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Policy Call Count"
    },
    "map_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Map Sha256"
    },
    "model_motion_decision_count": {
      "anyOf": [
        {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Motion Decision Count"
    },
    "navigation_expert_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/LocalPolicyTrainingMetrics"
      },
      "maxProperties": 3,
      "title": "Navigation Expert Metrics",
      "type": "object"
    },
    "p50_inference_latency_ms": {
      "maximum": 60000.0,
      "minimum": 0.0,
      "title": "P50 Inference Latency Ms",
      "type": "number"
    },
    "p95_inference_latency_ms": {
      "maximum": 60000.0,
      "minimum": 0.0,
      "title": "P95 Inference Latency Ms",
      "type": "number"
    },
    "p99_inference_latency_ms": {
      "maximum": 60000.0,
      "minimum": 0.0,
      "title": "P99 Inference Latency Ms",
      "type": "number"
    },
    "pilot_control_command_count": {
      "anyOf": [
        {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pilot Control Command Count"
    },
    "pilot_control_mean_absolute_error": {
      "anyOf": [
        {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pilot Control Mean Absolute Error"
    },
    "policy_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Package Sha256",
      "type": "string"
    },
    "qualified": {
      "title": "Qualified",
      "type": "boolean"
    },
    "realtime_feature_ready_call_count": {
      "anyOf": [
        {
          "maximum": 100000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Realtime Feature Ready Call Count"
    },
    "receipt_id": {
      "pattern": "^policy-qualification-[0-9a-f]{32}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "sensor_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sensor Contract Sha256",
      "type": "string"
    },
    "successful_trial_count": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Successful Trial Count",
      "type": "integer"
    },
    "trial_count": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Trial Count",
      "type": "integer"
    },
    "vehicle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Vehicle Sha256",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "policy_package_sha256",
    "evaluation_suite_sha256",
    "vehicle_sha256",
    "sensor_contract_sha256",
    "trial_count",
    "successful_trial_count",
    "collision_count",
    "deterministic_safety_intervention_count",
    "p50_inference_latency_ms",
    "p95_inference_latency_ms",
    "p99_inference_latency_ms",
    "qualified"
  ],
  "title": "LocalPolicyQualificationReceipt",
  "type": "object"
}
