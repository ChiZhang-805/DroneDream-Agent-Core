{
  "$defs": {
    "MissionVerificationRequirement": {
      "additionalProperties": false,
      "description": "One evidence requirement compiled from the accepted task and control contracts.",
      "properties": {
        "blocking": {
          "const": true,
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "evidence_authority": {
          "enum": [
            "deterministic-core",
            "qualified-tool",
            "runtime-checkpoint",
            "runtime-action-adapter",
            "px4-telemetry",
            "completion-verifier"
          ],
          "title": "Evidence Authority",
          "type": "string"
        },
        "evidence_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Evidence Key",
          "type": "string"
        },
        "model_only_evidence_accepted": {
          "const": false,
          "default": false,
          "title": "Model Only Evidence Accepted",
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "pre-confirmation",
            "runtime",
            "completion"
          ],
          "title": "Phase",
          "type": "string"
        },
        "required_before": {
          "enum": [
            "user-confirmation",
            "task-advance",
            "mission-completion"
          ],
          "title": "Required Before",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^verification-[0-9]{3,6}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "schema_version": {
          "const": "dronedream.mission-verification-requirement.v1",
          "default": "dronedream.mission-verification-requirement.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_binding_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Binding Sha256",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "enum": [
            "mission",
            "task",
            "route",
            "track",
            "runtime-action",
            "landing"
          ],
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "phase",
        "subject_type",
        "subject_id",
        "evidence_key",
        "evidence_authority",
        "source_binding_sha256",
        "required_before"
      ],
      "title": "MissionVerificationRequirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hash-bound verification matrix reviewed before the user can confirm execution.",
  "properties": {
    "contract_id": {
      "pattern": "^mission-[0-9a-f]{24}$",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "deterministic_gates": {
      "additionalProperties": {
        "type": "boolean"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "title": "Deterministic Gates",
      "type": "object"
    },
    "execution_route_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Route Sha256",
      "type": "string"
    },
    "flight_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Flight Plan Sha256",
      "type": "string"
    },
    "plan_revision": {
      "minimum": 1,
      "title": "Plan Revision",
      "type": "integer"
    },
    "px4_track_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Px4 Track Sha256",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/MissionVerificationRequirement"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "route_clearance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Route Clearance Sha256",
      "type": "string"
    },
    "runtime_actions_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Actions Sha256",
      "type": "string"
    },
    "runtime_checkpoints_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Checkpoints Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.mission-verification-plan.v1",
      "default": "dronedream.mission-verification-plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Plan Sha256",
      "type": "string"
    },
    "task_graph_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Graph Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract_id",
    "plan_revision",
    "contract_sha256",
    "task_graph_sha256",
    "semantic_plan_sha256",
    "flight_plan_sha256",
    "execution_route_sha256",
    "route_clearance_sha256",
    "px4_track_sha256",
    "runtime_checkpoints_sha256",
    "runtime_actions_sha256",
    "deterministic_gates",
    "requirements"
  ],
  "title": "MissionVerificationPlan",
  "type": "object"
}
