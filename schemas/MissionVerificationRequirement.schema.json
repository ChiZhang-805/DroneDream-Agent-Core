{
  "additionalProperties": false,
  "description": "One evidence requirement compiled from the accepted task and control contracts.",
  "properties": {
    "blocking": {
      "const": true,
      "default": true,
      "title": "Blocking",
      "type": "boolean"
    },
    "evidence_authority": {
      "enum": [
        "deterministic-core",
        "qualified-tool",
        "runtime-checkpoint",
        "runtime-action-adapter",
        "px4-telemetry",
        "completion-verifier"
      ],
      "title": "Evidence Authority",
      "type": "string"
    },
    "evidence_key": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Evidence Key",
      "type": "string"
    },
    "model_only_evidence_accepted": {
      "const": false,
      "default": false,
      "title": "Model Only Evidence Accepted",
      "type": "boolean"
    },
    "phase": {
      "enum": [
        "pre-confirmation",
        "runtime",
        "completion"
      ],
      "title": "Phase",
      "type": "string"
    },
    "required_before": {
      "enum": [
        "user-confirmation",
        "task-advance",
        "mission-completion"
      ],
      "title": "Required Before",
      "type": "string"
    },
    "requirement_id": {
      "pattern": "^verification-[0-9]{3,6}$",
      "title": "Requirement Id",
      "type": "string"
    },
    "schema_version": {
      "const": "dronedream.mission-verification-requirement.v1",
      "default": "dronedream.mission-verification-requirement.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Binding Sha256",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "subject_type": {
      "enum": [
        "mission",
        "task",
        "route",
        "track",
        "runtime-action",
        "landing"
      ],
      "title": "Subject Type",
      "type": "string"
    }
  },
  "required": [
    "requirement_id",
    "phase",
    "subject_type",
    "subject_id",
    "evidence_key",
    "evidence_authority",
    "source_binding_sha256",
    "required_before"
  ],
  "title": "MissionVerificationRequirement",
  "type": "object"
}
